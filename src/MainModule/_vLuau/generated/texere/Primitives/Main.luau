        return
    end
    mem.low0 = buffer.create(0)
    mem.end0 = 0
    mem.low1 = buffer.create(0)
    mem.end1 = 1048576
    table.clear(mem.pages)
    mem.size = 0
    mem.on_grow = nil
    for _, listener in mem.listeners do
        listener()
    end
end

