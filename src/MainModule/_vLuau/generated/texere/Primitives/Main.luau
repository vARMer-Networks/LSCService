local function push_trap_hook(trap_hooks, hook)
    local thread = coroutine.running() or trap_hooks
    local prev = trap_hooks[thread]
    trap_hooks[thread] = hook
    return prev
end

local function pop_trap_hook(trap_hooks, prev)
    trap_hooks[coroutine.running() or trap_hooks] = prev
end

local function memory_dispose(mem)
