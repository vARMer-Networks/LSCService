local function wrap_import_hooks(fn, ns, name, hooks)
    local before = hooks and hooks.onImportCall
    local after = hooks and hooks.afterImportCall
    if not before and not after then
        return fn
    end
    return function(...)
        if before then
            before(ns, name, ...)
        end
        if not after then
            return fn(...)
        end
        local res = table.pack(pcall(fn, ...))
        after(ns, name, res[1], table.unpack(res, 2, res.n))
        if not res[1] then
            error(res[2], 0)
        end
        return table.unpack(res, 2, res.n)
    end
end

local function wrap_export_hooks(fn, name, hooks, on_trap, is_disposed, trap_hooks)
    local before = hooks and hooks.onExportCall
    local after = hooks and hooks.afterExportCall
    if not before and not after and not on_trap and not is_disposed then
        return fn
    end
    return function(...)
        if is_disposed and is_disposed() then
            error("Texere instance has been disposed", 0)
        end
        if before then
            before(name, ...)
        end
        if not after and not on_trap then
            return fn(...)
        end
        local prev = if on_trap then push_trap_hook(trap_hooks, on_trap) else nil
        local res = table.pack(pcall(fn, ...))
        if on_trap then
            pop_trap_hook(trap_hooks, prev)
        end
        if after then
            after(name, res[1], table.unpack(res, 2, res.n))
        end
        if not res[1] then
            error(res[2], 0)
        end
        return table.unpack(res, 2, res.n)
    end
end

