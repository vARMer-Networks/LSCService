-- Generated by Texere.
local new_runtime = if script then require(script.Parent.Runtime) else require("./Runtime")
local host_runtime = new_runtime()
local new_global = host_runtime.new_global
local host_memory = host_runtime.host_memory
local host_table = host_runtime.host_table
local chunk_loaders = {
    function() return if script then require(script.Parent.Functions.Chunk0001) else require("./Functions/Chunk0001") end,
    function() return if script then require(script.Parent.Functions.Chunk0002) else require("./Functions/Chunk0002") end,
    function() return if script then require(script.Parent.Functions.Chunk0003) else require("./Functions/Chunk0003") end,
    function() return if script then require(script.Parent.Functions.Chunk0004) else require("./Functions/Chunk0004") end,
    function() return if script then require(script.Parent.Functions.Chunk0005) else require("./Functions/Chunk0005") end,
    function() return if script then require(script.Parent.Functions.Chunk0006) else require("./Functions/Chunk0006") end,
    function() return if script then require(script.Parent.Functions.Chunk0007) else require("./Functions/Chunk0007") end,
    function() return if script then require(script.Parent.Functions.Chunk0008) else require("./Functions/Chunk0008") end,
    function() return if script then require(script.Parent.Functions.Chunk0009) else require("./Functions/Chunk0009") end,
}
local chunks = {}
local loaded_chunks = 0

local function load_chunk(index)
    local chunk = chunks[index]
    if chunk == nil then
        chunk = chunk_loaders[index]()
        if chunks[index] == nil then
            chunks[index] = chunk
            loaded_chunks += 1
        end
    end
    return chunk
end

local function ensure_chunks()
    if loaded_chunks < #chunk_loaders then
        for index = 1, #chunk_loaders do
            load_chunk(index)
        end
    end
end

local function prewarm_chunks(yield_fn)
    local total = #chunk_loaders
    if loaded_chunks >= total then
        return total
    end
    for index = 1, total do
        if chunks[index] == nil then
            load_chunk(index)
            if yield_fn and loaded_chunks < total then
                yield_fn(loaded_chunks, total)
            end
        end
    end
    return total
end

local function prewarm_cooperative(budget_seconds, yield_fn)
    local total = #chunk_loaders
    if loaded_chunks >= total then
        return total
    end
    local budget = if budget_seconds == nil then 0.004 else budget_seconds
    local step_yield = yield_fn or (if task and task.wait then function() task.wait() end else nil)
    local slice_start = os.clock()
    for index = 1, total do
        if chunks[index] == nil then
            load_chunk(index)
            if step_yield and loaded_chunks < total and (os.clock() - slice_start) >= budget then
                step_yield(loaded_chunks, total)
                slice_start = os.clock()
            end
        end
    end
    return total
end
-- Experimental execution controller for one generated instance.
local CHECKPOINT = table.freeze({})
local MAIN_THREAD = table.freeze({})
local MAX_WORK = 2 ^ 53 - 1
local CLOCK_CHECK_INTERVAL = 8

local function new_execution(trap_frames, on_checkpoint)
    local active, activeThread, synchronous, discarded, atomicDepth = nil, nil, nil, false, 0
    local remaining, deadline, nextClock, clockInterval = 0, nil, 0, 0
    local profile, lastCheckpointAt, maxCheckpointGap = false, nil, 0
    local pendingCleanup, fastLimit = false, math.huge
    local allowFast = on_checkpoint == nil

    local function markFailure()
        pendingCleanup = true
        fastLimit = math.huge
    end

    local function checkAccess()
        assert(not discarded, "Texere execution instance was discarded")
        local thread = coroutine.running() or MAIN_THREAD
        local owner = if active then active.thread else synchronous
        assert(owner == nil or owner == thread, "Texere execution instance is busy")
        return thread
    end

    local function guard(target)
        return function(...)
            if activeThread ~= nil and coroutine.running() == activeThread then
                return target(...)
            end
            local thread = checkAccess()
            if active or synchronous then
                return target(...)
            end
            synchronous = thread
            local ok, result = pcall(target, ...)
            synchronous = nil
            if not ok then error(result, 0) end
            -- Internal Wasm calls return zero values or one non-nil value (packed for multi-value).
            if result ~= nil then return result end
        end
    end

    local function wrapImport(target)
        return function(...)
            local current = active
            if not current then return target(...) end
            local priorTrap = current.trap
            current.trap = nil
            atomicDepth += 1
            fastLimit = math.huge
            local ok, result = pcall(target, ...)
            atomicDepth -= 1
            if not ok then
                current.importFailed, current.importError = true, result
                markFailure()
                error(result, 0)
            end
            current.trap = priorTrap
            fastLimit = if allowFast and active and atomicDepth == 0 and not profile and not pendingCleanup then nextClock else math.huge
            if result ~= nil then return result end
        end
    end

    -- A trusted adapter can isolate its guest trampoline from atomic host setup and cleanup.
    local function protectedGuestCall(target, ...)
        if not active then return pcall(target, ...) end
        checkAccess()
        assert(atomicDepth > 0, "guest trampoline requires an active import")
        atomicDepth -= 1
        fastLimit = if allowFast and active and atomicDepth == 0 and not profile and not pendingCleanup then nextClock else math.huge
        local ok, result = pcall(target, ...)
        atomicDepth += 1
        if not ok then
            markFailure()
        else
            fastLimit = if allowFast and active and atomicDepth == 0 and not profile and not pendingCleanup then nextClock else math.huge
        end
        return ok, result
    end

    local function checkpoint(functionIndex, block, offset)
        if remaining > fastLimit then
            remaining -= 1
            return
        end
        local current = active
        if not current or atomicDepth > 0 then return end
        if on_checkpoint then
            if block == nil then
                on_checkpoint(functionIndex // 65536, functionIndex % 65536, 0, remaining)
            else
                on_checkpoint(functionIndex, block, offset, remaining)
            end
        end
        if pendingCleanup then
            if current.importFailed then current.importFailed, current.importError = false, nil end
            if current.trap then current.trap = nil end
            pendingCleanup = false
            if allowFast and not profile then fastLimit = nextClock end
        end
        local now
        if profile then
            now = os.clock()
            if lastCheckpointAt then maxCheckpointGap = math.max(maxCheckpointGap, now - lastCheckpointAt) end
            lastCheckpointAt = now
        end
        if remaining <= nextClock then
            if remaining == 0 or (now or os.clock()) >= deadline then
                if block == nil then
                    block = functionIndex % 65536
                    functionIndex //= 65536
                    offset = 0
                end
                coroutine.yield(CHECKPOINT, functionIndex, block, offset)
                -- A restored slice starts at the suspension point and admits this region first.
                if profile then lastCheckpointAt = os.clock() end
            else
                nextClock = math.max(0, remaining - clockInterval)
                if not profile and allowFast then fastLimit = nextClock end
            end
        end
        remaining -= 1
    end

    local function beginTask(target, ...)
        assert(type(target) == "function", "Texere execution task must be a function")
        assert(not discarded, "Texere execution instance was discarded")
        assert(not active and not synchronous, "Texere execution instance is busy")
        local args = table.pack(...)
        local frame = {
            work = 0,
            onTrap = markFailure,
            thread = coroutine.create(function()
                return table.pack(target(table.unpack(args, 1, args.n)))
            end),
        }
        local status, result, problem, kind = "ready", nil, nil, nil
        local position, positionFunction, positionBlock, positionOffset
        local slices, sliceBudget = 0, 0
        local gapMs
        local jobOwned = true
        local job = {}
        active = frame
        activeThread = frame.thread

        local function finish(terminal, discard)
            status = terminal
            discarded = discard
            active = nil
            activeThread = nil
            pendingCleanup = false
            fastLimit = math.huge
            jobOwned = false
            frame.onTrap = nil
            frame.thread = nil
            frame.importError = nil
        end

        function job:getStatus() return status end
        function job:getPosition()
            if not position and positionFunction then
                position = table.freeze({functionIndex = positionFunction, block = positionBlock, instructionOffset = positionOffset})
            end
            return position
        end
        function job:getStats()
            local running = status == "running"
            local work = if running then frame.work + (sliceBudget - remaining) else frame.work
            local gap = if running and profile then maxCheckpointGap * 1000 else nil
            if gap then gap = math.max(gap, gapMs or 0) else gap = gapMs end
            return {work = work, slices = slices, maxCheckpointGapMs = gap}
        end
        function job:getFailure() return kind, problem end
        function job:isComplete() return not jobOwned end

        function job:getResult()
            if status == "failed" or status == "trapped" then error(problem, 0) end
            assert(status == "completed", "Texere execution has no result (" .. status .. ")")
            return table.unpack(result, 1, result.n)
        end

        local function runSlice(workBudget, expiresAt, interval, measureCheckpoints)
            assert(status == "ready" or status == "suspended", "cannot step Texere execution in state " .. status)
            sliceBudget, remaining = workBudget, workBudget
            deadline, clockInterval = expiresAt, interval
            nextClock = if expiresAt then workBudget - interval else 0
            profile, lastCheckpointAt, maxCheckpointGap = measureCheckpoints == true, nil, 0
            status = "running"
            slices += 1
            local thread = frame.thread
            trap_frames[thread] = frame
            fastLimit = if allowFast and atomicDepth == 0 and not profile and not pendingCleanup then nextClock else math.huge
            local ok, value, fn, block, offset = coroutine.resume(thread)
            fastLimit = math.huge
            trap_frames[thread] = nil
            frame.work += workBudget - remaining
            if profile then gapMs = math.max(gapMs or 0, maxCheckpointGap * 1000) end
            if not ok then
                problem = value
                if frame.trap ~= nil and frame.trap == value then
                    kind = "wasm trap"
                    finish("trapped", false)
                else
                    kind = if frame.importFailed and rawequal(frame.importError, value) then "host import" else "execution fault"
                    finish("failed", true)
                end
            elseif type(value) == "table" and value ~= CHECKPOINT and coroutine.status(thread) == "dead" then
                result = value
                finish("completed", false)
            elseif value == CHECKPOINT then
                position, positionFunction, positionBlock, positionOffset = nil, fn, block, offset
                status = "suspended"
            else
                coroutine.close(frame.thread)
                kind, problem = "unexpected yield", "Texere execution callback yielded outside a guest checkpoint"
                finish("failed", true)
            end
            return status
        end

        function job:step(workBudget, measureCheckpoints)
            assert(type(workBudget) == "number" and workBudget >= 1 and workBudget <= MAX_WORK and workBudget % 1 == 0,
                "work budget must be a positive safe integer")
            return runSlice(workBudget, nil, 0, measureCheckpoints)
        end

        function job:stepFor(milliseconds, measureCheckpoints)
            assert(type(milliseconds) == "number" and milliseconds > 0 and milliseconds < math.huge,
                "time budget must be a positive finite number of milliseconds")
            local interval = if milliseconds <= 0.25 then 1 else CLOCK_CHECK_INTERVAL
            return runSlice(MAX_WORK, os.clock() + milliseconds / 1000, interval, measureCheckpoints)
        end

        function job:cancel()
            assert(status ~= "running", "cannot cancel a running Texere execution")
            if not jobOwned then return false end
            coroutine.close(frame.thread)
            finish("cancelled", slices > 0)
            return true
        end

        return table.freeze(job)
    end

    return checkpoint, guard, wrapImport, beginTask, protectedGuestCall
end

local REGISTRY_TAG = table.freeze({})

local function is_registry(value)
    return type(value) == "table" and rawget(value, "__texere_registry") == REGISTRY_TAG
end

local function new_registry(initial)
    local store, listeners, refs, weaks, next_id = {}, {}, {}, {}, 0
    if type(initial) == "table" then
        for k, v in initial do
            store[k] = v
        end
    end
    local function emit(key, next_val, prev_val)
        for i = 1, #listeners do
            local fn = listeners[i]
            if fn then
                fn(key, next_val, prev_val)
            end
        end
    end
    local function scope(tag)
        local tag_len = if tag then #tag else 0
        local function full_key(k)
            return if tag then tag .. tostring(k) else k
        end
        local function match_key(k)
            return not tag or (type(k) == "string" and string.sub(k, 1, tag_len) == tag)
        end
        local function short_key(k)
            return if tag then string.sub(k, tag_len + 1) else k
        end
        local function put(fk, val)
            local prev = store[fk]
            store[fk] = val
            emit(fk, val, prev)
            return val
        end
        local api = {}
        function api:get(k)
            return store[full_key(k)]
        end
        function api:has(k)
            return store[full_key(k)] ~= nil
        end
        function api:set(k, v)
            return put(full_key(k), v)
        end
        function api:delete(k)
            local fk = full_key(k)
            if store[fk] == nil then
                return false
            end
            put(fk, nil)
            return true
        end
        function api:getOrCreate(k, factory)
            local fk = full_key(k)
            local v = store[fk]
            return if v ~= nil then v else put(fk, factory(k))
        end
        function api:keys()
            local out = {}
            for k in store do
                if match_key(k) then
                    out[#out + 1] = short_key(k)
                end
            end
            return out
        end
        function api:snapshot()
            local out = {}
            for k, v in store do
                if match_key(k) then
                    out[short_key(k)] = v
                end
            end
            return out
        end
        function api:clear()
            for _, k in api:keys() do
                api:delete(k)
            end
        end
        function api:weak(name, mode)
            local fk = full_key(name)
            local tbl = weaks[fk]
            if tbl then
                return tbl
            end
            mode = mode or "k"
            assert(mode == "k" or mode == "v" or mode == "kv", "expected weak mode 'k', 'v', or 'kv'")
            tbl = setmetatable({}, { __mode = mode })
            weaks[fk] = tbl
            return tbl
        end
        function api:onChange(fn)
            assert(type(fn) == "function", "expected registry listener function")
            local idx = #listeners + 1
            listeners[idx] = function(fk, next_val, prev_val)
                if match_key(fk) then
                    fn(short_key(fk), next_val, prev_val)
                end
            end
            return function()
                listeners[idx] = false
            end
        end
        return api
    end
    local root = scope(nil)
    root.__texere_registry = REGISTRY_TAG
    function root:ref(v)
        assert(v ~= nil, "cannot reference nil")
        next_id += 1
        refs[next_id] = v
        return next_id
    end
    function root:getRef(id)
        return refs[id]
    end
    function root:unref(id)
        local prev = refs[id]
        refs[id] = nil
        return prev
    end
    function root:namespace(prefix)
        assert(type(prefix) == "string" and #prefix > 0, "expected non-empty namespace")
        return table.freeze(scope(prefix .. ":"))
    end
    return table.freeze(root)
end

local function new_gc(cfg, mem, mem_committed_fn)
    cfg = cfg or {}
    local weak_refs = setmetatable({}, { __mode = "k" })
    local entries = {}
    local next_id, tracked, total_tracked, total_finalized, total_collections, total_sweeps, disposed =
        0, 0, 0, 0, 0, 0, false
    local gc = {}
    local function finalize(id, entry)
        entries[id] = nil
        tracked -= 1
        total_finalized += 1
        if entry.finalizer then
            pcall(entry.finalizer, entry.meta, id)
        end
        if cfg.onFinalize then
            pcall(cfg.onFinalize, entry, gc)
        end
    end
    function gc:track(obj, finalizer_or_meta, meta)
        assert(not disposed, "GC handler disposed")
        assert(obj ~= nil, "cannot track nil")
        local fin = if type(finalizer_or_meta) == "function" then finalizer_or_meta else nil
        next_id += 1
        weak_refs[obj] = next_id
        entries[next_id] = {
            id = next_id,
            kind = type(obj),
            finalizer = fin,
            meta = if fin then meta else finalizer_or_meta,
        }
        tracked += 1
        total_tracked += 1
        return next_id
    end
    function gc:untrack(target)
        local id = if type(target) == "number" then target else weak_refs[target]
        if type(target) ~= "number" and target ~= nil then
            weak_refs[target] = nil
        end
        if id and entries[id] then
            entries[id] = nil
            tracked -= 1
            return true
        end
        return false
    end
    function gc:sweep()
        total_sweeps += 1
        local alive, dead = {}, {}
        for _, id in weak_refs do
            alive[id] = true
        end
        for id in entries do
            if not alive[id] then
                dead[#dead + 1] = id
            end
        end
        for _, id in dead do
            finalize(id, entries[id])
        end
        return #dead
    end
    function gc:getMemoryKB()
        if cfg.getMemoryKB then
            return cfg.getMemoryKB(gc)
        elseif collectgarbage then
            return collectgarbage("count")
        elseif mem and mem_committed_fn then
            return mem_committed_fn(mem) / 1024
        end
        return 0
    end
    function gc:collect(reason)
        if disposed then
            return 0
        end
        total_collections += 1
        if cfg.collect then
            cfg.collect("full", reason or "manual", gc)
        elseif collectgarbage then
            pcall(collectgarbage, "collect")
        end
        return gc:sweep()
    end
    function gc:notifyAlloc(kind, obj, bytes, meta)
        if disposed then
            return
        end
        if cfg.onAllocate then
            cfg.onAllocate(kind, obj, bytes, meta, gc)
        end
        local soft, hard = cfg.softLimitBytes, cfg.hardLimitBytes
        if soft or hard then
            local current = if cfg.getMemoryKB
                then cfg.getMemoryKB(gc) * 1024
                elseif kind == "memory" and type(meta) == "table" and meta.committedBytes
                then meta.committedBytes
                else gc:getMemoryKB() * 1024
            if soft and current > soft and cfg.onMemoryPressure then
                cfg.onMemoryPressure({ bytes = current, limit = soft, kind = kind }, gc)
            end
            if hard and current > hard then
                gc:collect("pressure")
                local after = if cfg.getMemoryKB
                    then cfg.getMemoryKB(gc) * 1024
                    elseif kind == "memory" and type(meta) == "table" and meta.committedBytes
                    then meta.committedBytes
                    else gc:getMemoryKB() * 1024
                if after > hard then
                    error("Texere GC memory limit exceeded", 0)
                end
            end
        end
    end
    function gc:getStats()
        return {
            trackedCount = tracked,
            totalTracked = total_tracked,
            totalFinalized = total_finalized,
            totalCollections = total_collections,
            totalSweeps = total_sweeps,
            memoryKB = gc:getMemoryKB(),
            committedBytes = if mem and mem_committed_fn then mem_committed_fn(mem) else 0,
            disposed = disposed,
        }
    end
    function gc:dispose()
        if disposed then
            return
        end
        disposed = true
        local ids = {}
        for id in entries do
            ids[#ids + 1] = id
        end
        table.sort(ids)
        for _, id in ids do
            finalize(id, entries[id])
        end
        table.clear(weak_refs)
    end
    return table.freeze(gc)
end

local function compose_options(opts)
    if opts == nil then
        return nil
    end
    assert(type(opts) == "table", "expected options table")
    local function chain_fn(prev, next_fn, mode)
        if next_fn == nil then
            return prev
        end
        assert(type(next_fn) == "function", "expected callback function")
        if prev == nil then
            return next_fn
        end
        if mode == 1 then
            return function(...)
                local v = prev(...)
                return if v ~= nil then v else next_fn(...)
            end
        elseif mode == 2 then
            return function(reason)
                local a = prev(reason)
                local b = next_fn(if type(a) == "string" then a else reason)
                return if type(b) == "string" then b else a
            end
        end
        return function(...)
            prev(...)
            return next_fn(...)
        end
    end
    local acc = { globals = {}, importOverrides = {}, hooks = {}, gc = {} }
    local io = acc.importOverrides
    local function merge(src)
        if type(src) == "function" then
            src(acc)
            return
        end
        assert(type(src) == "table", "expected plugin table or function")
        local plugins = src.plugins or src.extensions
        if plugins ~= nil then
            assert(type(plugins) == "table", "expected plugins list")
            for _, p in plugins do
                merge(p)
            end
        end
        if type(src.globals) == "table" then
            for k, v in src.globals do
                acc.globals[k] = v
            end
        end
        local ov = src.importOverrides or src.imports
        if type(ov) == "table" then
            for ns, group in ov do
                if type(group) == "table" then
                    local dst = io[ns]
                    if not dst then
                        dst = {}
                        io[ns] = dst
                    end
                    for k, v in group do
                        dst[k] = v
                    end
                end
            end
        end
        acc.resolveImport = chain_fn(acc.resolveImport, src.resolveImport, 1)
        if type(src.hooks) == "table" then
            for name, fn in src.hooks do
                acc.hooks[name] = chain_fn(acc.hooks[name], fn, if name == "onTrap" then 2 else 0)
            end
        end
        if type(src.gc) == "table" then
            for k, v in src.gc do
                acc.gc[k] = if type(v) == "function" and k ~= "collect" and k ~= "getMemoryKB"
                    then chain_fn(acc.gc[k], v, 0)
                    else v
            end
        end
        local reg = src.registry
        if reg ~= nil then
            if is_registry(reg) then
                acc.registry = reg
            elseif type(reg) == "table" then
                acc.reg_init = acc.reg_init or {}
                for k, v in reg do
                    acc.reg_init[k] = v
                end
            else
                error("expected registry or initial registry table", 2)
            end
        end
        if src.guardDispose ~= nil then
            acc.guardDispose = src.guardDispose
        end
    end
    merge(opts)
    if not acc.registry and acc.reg_init then
        acc.registry = new_registry(acc.reg_init)
    end
    return acc
end

local function push_trap_hook(trap_hooks, hook)
    local thread = coroutine.running() or trap_hooks
    local prev = trap_hooks[thread]
    trap_hooks[thread] = hook
    return prev
end

local function pop_trap_hook(trap_hooks, prev)
    trap_hooks[coroutine.running() or trap_hooks] = prev
end

local function memory_dispose(mem)
    if not mem then
        return
    end
    mem.low0 = buffer.create(0)
    mem.end0 = 0
    mem.low1 = buffer.create(0)
    mem.end1 = 1048576
    table.clear(mem.pages)
    mem.size = 0
    mem.on_grow = nil
    for _, listener in mem.listeners do
        listener()
    end
end

local function is_texere_handle(val, kind)
    local state = if type(val) == "table" and table.isfrozen(val) then rawget(val, "__texere_v1") else nil
    return type(state) == "table" and table.isfrozen(state) and rawget(state, "kind") == kind
end

local function wrap_import_hooks(fn, ns, name, hooks)
    local before = hooks and hooks.onImportCall
    local after = hooks and hooks.afterImportCall
    if not before and not after then
        return fn
    end
    return function(...)
        if before then
            before(ns, name, ...)
        end
        if not after then
            return fn(...)
        end
        local res = table.pack(pcall(fn, ...))
        after(ns, name, res[1], table.unpack(res, 2, res.n))
        if not res[1] then
            error(res[2], 0)
        end
        return table.unpack(res, 2, res.n)
    end
end

local function wrap_export_hooks(fn, name, hooks, on_trap, is_disposed, trap_hooks)
    local before = hooks and hooks.onExportCall
    local after = hooks and hooks.afterExportCall
    if not before and not after and not on_trap and not is_disposed then
        return fn
    end
    return function(...)
        if is_disposed and is_disposed() then
            error("Texere instance has been disposed", 0)
        end
        if before then
            before(name, ...)
        end
        if not after and not on_trap then
            return fn(...)
        end
        local prev = if on_trap then push_trap_hook(trap_hooks, on_trap) else nil
        local res = table.pack(pcall(fn, ...))
        if on_trap then
            pop_trap_hook(trap_hooks, prev)
        end
        if after then
            after(name, res[1], table.unpack(res, 2, res.n))
        end
        if not res[1] then
            error(res[2], 0)
        end
        return table.unpack(res, 2, res.n)
    end
