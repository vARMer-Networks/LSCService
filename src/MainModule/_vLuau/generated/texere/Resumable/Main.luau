local GLOBAL_KIND_NAMES = { i = "i32", j = "i64", f = "f32", d = "f64" }

local function prepare_import(eff, imports, custom, ns, name, kind, opt1, opt2, new_global_fn)
    local ov_ns = rawget(custom.importOverrides, ns)
    local val = if type(ov_ns) == "table" then rawget(ov_ns, name) else nil
    local raw_ns = rawget(imports, ns)
    local raw_val = if type(raw_ns) == "table" then rawget(raw_ns, name) else nil
    if val == nil then
        if custom.resolveImport then
            val = custom.resolveImport(ns, name, raw_val, kind, opt1, opt2)
        end
        if val == nil then
            val = raw_val
        end
    end
    if val ~= nil then
        if kind == "function" and type(val) == "function" then
            val = wrap_import_hooks(val, ns, name, custom.hooks)
        elseif kind == "global" and new_global_fn and not is_texere_handle(val, "global") then
            if type(val) == "number" or (opt1 == "j" and type(val) == "table" and rawget(val, "lo") ~= nil) then
                val = new_global_fn(GLOBAL_KIND_NAMES[opt1], opt2, val)
            end
        end
        local dst = rawget(eff, ns)
        if type(dst) ~= "table" then
            dst = {}
            eff[ns] = dst
        end
        dst[name] = val
    end
end

