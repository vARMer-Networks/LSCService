-- already checked the guest range against the memory size, so these pages exist in the memory.
local function grow_first(memory, finish)
    local grown = buffer.create(finish)
    buffer.copy(grown, 0, memory.low0, 0, memory.end0)
    memory.low0 = grown
    memory.end0 = finish
    notify_grow(memory)
end

local function grow_second(memory, finish)
    local grown = buffer.create(finish - SEGMENT)
    buffer.copy(grown, 0, memory.low1, 0, memory.end1 - SEGMENT)
    memory.low1 = grown
    memory.end1 = finish
    notify_grow(memory)
end

-- Returns the buffer holding guest page `index` and that page's byte offset in it, or nil when the
-- page was never written and reads as zero.
local function find_page(memory, index)
    if index < SEGMENT_PAGES then
        local base = index * PAGE_SIZE
        if base < memory.end0 then
            return memory.low0, base
        end
    elseif index < SEGMENT_PAGES * 2 then
        local base = index * PAGE_SIZE
        if base < memory.end1 then
            return memory.low1, base - SEGMENT
        end
    else
        return memory.pages[index], 0
    end
    return nil, 0
end

local function writable_page(memory, index)
    if index < SEGMENT_PAGES then
        if index * PAGE_SIZE >= memory.end0 then
            grow_first(memory, (index + 1) * PAGE_SIZE)
        end
        return memory.low0, index * PAGE_SIZE
    elseif index < SEGMENT_PAGES * 2 then
        if index * PAGE_SIZE >= memory.end1 then
            grow_second(memory, (index + 1) * PAGE_SIZE)
        end
        return memory.low1, index * PAGE_SIZE - SEGMENT
    end
    local page = memory.pages[index]
    if not page then
        page = buffer.create(PAGE_SIZE)
        memory.pages[index] = page
        notify_grow(memory)
    end
    return page, 0
end

local function memory_read_bytes(memory, start, width)
    local finish = start + width
    if finish <= memory.end0 then
        local low = memory.low0
        if width == 4 then
            return buffer.readu32(low, start)
        elseif width == 1 then
            return buffer.readu8(low, start)
        end
        return buffer.readu16(low, start)
    elseif start >= SEGMENT and finish <= memory.end1 then
        local low = memory.low1
        start -= SEGMENT
        if width == 4 then
            return buffer.readu32(low, start)
        elseif width == 1 then
            return buffer.readu8(low, start)
        end
        return buffer.readu16(low, start)
    end
    local offset = start % PAGE_SIZE
    -- Callers have already checked the full guest range. Only use a typed
    -- buffer access when these 1, 2 or 4 bytes fit in the same sparse page.
    if start >= LOW_LIMIT and offset + width <= PAGE_SIZE then
        local page = memory.pages[start // PAGE_SIZE]
        if not page then
            return 0
        elseif width == 4 then
            return buffer.readu32(page, offset)
        elseif width == 1 then
            return buffer.readu8(page, offset)
        end
        return buffer.readu16(page, offset)
    end
    local value = 0
    local place = 1
    for index = start, finish - 1 do
        local page, base = find_page(memory, index // PAGE_SIZE)
        if page then
            value += buffer.readu8(page, base + index % PAGE_SIZE) * place
        end
        place *= 256
    end
    return value
end

local function memory_load(memory, address, offset, width, signed)
    local value
    local start = address + offset
    local finish = start + width
    if address >= 0 and finish <= memory.end0 then
        local low = memory.low0
        if width == 4 then
            value = buffer.readu32(low, start)
        elseif width == 1 then
            value = buffer.readu8(low, start)
        else
            value = buffer.readu16(low, start)
        end
    elseif address >= 0 and start >= SEGMENT and finish <= memory.end1 then
        local low = memory.low1
        start -= SEGMENT
        if width == 4 then
            value = buffer.readu32(low, start)
        elseif width == 1 then
            value = buffer.readu8(low, start)
        else
            value = buffer.readu16(low, start)
        end
    else
        start = memory_address(memory, address, offset, width)
        value = memory_read_bytes(memory, start, width)
    end
    local place = 256 ^ width
    if (signed or width == 4) and value >= place / 2 then
        return value - place
    end
    return value
end

local function memory_write_bytes(memory, start, width, value)
    local finish = start + width
    local low, at
    if finish <= SEGMENT then
        if finish > memory.end0 then
            grow_first(memory, ((finish - 1) // PAGE_SIZE + 1) * PAGE_SIZE)
        end
        low, at = memory.low0, start
    elseif start >= SEGMENT and finish <= LOW_LIMIT then
        if finish > memory.end1 then
            grow_second(memory, ((finish - 1) // PAGE_SIZE + 1) * PAGE_SIZE)
        end
        low, at = memory.low1, start - SEGMENT
    end
    if low then
        if width == 4 then
            buffer.writeu32(low, at, value)
        elseif width == 1 then
            buffer.writeu8(low, at, value)
        else
            buffer.writeu16(low, at, value)
        end
        return
    end
    local offset = start % PAGE_SIZE
    if start >= LOW_LIMIT and offset + width <= PAGE_SIZE then
        local page = writable_page(memory, start // PAGE_SIZE)
        if width == 4 then
            buffer.writeu32(page, offset, value)
        elseif width == 1 then
            buffer.writeu8(page, offset, value)
        else
            buffer.writeu16(page, offset, value)
        end
        return
    end
    for index = start, finish - 1 do
        local page, base = writable_page(memory, index // PAGE_SIZE)
        buffer.writeu8(page, base + index % PAGE_SIZE, value % 256)
        value //= 256
    end
end

local function memory_store(memory, address, offset, width, value)
    local start = address + offset
    local finish = start + width
    local low
    if address >= 0 then
        if finish <= memory.end0 then
            low = memory.low0
        elseif start >= SEGMENT and finish <= memory.end1 then
            low = memory.low1
            start -= SEGMENT
        end
    end
    if low then
        if width == 4 then
            buffer.writeu32(low, start, value)
        elseif width == 1 then
            buffer.writeu8(low, start, value)
        else
            buffer.writeu16(low, start, value)
        end
        return
    end
    start = memory_address(memory, address, offset, width)
    memory_write_bytes(memory, start, width, value)
end

local function memory_grow(memory, delta)
    local previous = memory.size
    local size = previous + delta % ADDRESS_SPACE
    if size > memory.maximum then
        return -1
    end
    memory.size = size
    if memory.on_grow then memory.on_grow(previous, delta, size) end
    return previous
end

-- Bytes of guest memory currently backed by buffers.
local function memory_committed(memory)
    local count = 0
    for _ in memory.pages do count += 1 end
    return memory.end0 + memory.end1 - SEGMENT + count * PAGE_SIZE
end

local function memory_init(memory, start, bytes)
    if #bytes == 0 then return end
    local offset = start % PAGE_SIZE
    if #bytes <= PAGE_SIZE - offset then
        local page, base = writable_page(memory, start // PAGE_SIZE)
        buffer.writestring(page, base + offset, bytes)
        return
    end
    local cursor = 1
    while cursor <= #bytes do
        local pageOffset = start % PAGE_SIZE
        local count = math.min(PAGE_SIZE - pageOffset, #bytes - cursor + 1)
        local page, base = writable_page(memory, start // PAGE_SIZE)
        buffer.writestring(page, base + pageOffset, string.sub(bytes, cursor, cursor + count - 1))
        cursor += count
        start += count
    end
end

local mem, low0, low1, end0, len1_1, len1_2, len1_4, len1_8
local chunk_listeners = {}

local function sync_memory()
    low0 = mem.low0
    low1 = mem.low1
    end0 = mem.end0
    local len1 = mem.end1 - SEGMENT
    len1_1 = len1 - 1
    len1_2 = len1 - 2
    len1_4 = len1 - 4
    len1_8 = len1 - 8
    for _, listener in chunk_listeners do
        listener(low0, low1, end0, len1_1, len1_2, len1_4, len1_8)
    end
end

local function bind_memory(memory)
    mem = memory
    sync_memory()
    table.insert(memory.listeners, sync_memory)
end

local function on_memory(listener)
    table.insert(chunk_listeners, listener)
    if mem then
        listener(low0, low1, end0, len1_1, len1_2, len1_4, len1_8)
    end
end

-- The fast paths test `address >= 0` because the wrapped unsigned address of a negative i32 is at
-- least 2^31, and a static offset added to it must still trap against the memory size. They test the
-- end of the range against `end0` or `len1_*` because a backed segment never exceeds the memory size.
-- The second segment is tested first: it holds the stack and the heap, which take most accesses.
local function load_u8(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_1 then
                return buffer.readu8(low1, off1)
            end
        elseif start < end0 then
            return buffer.readu8(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 1)
    local page, base = find_page(mem, start // PAGE_SIZE)
    return if page then buffer.readu8(page, base + start % PAGE_SIZE) else 0
end

local function store_u8(address, offset, value)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_1 then
                buffer.writeu8(low1, off1, value)
                return
            end
        elseif start < end0 then
            buffer.writeu8(low0, start, value)
            return
        end
    end
    start = memory_address(mem, address, offset, 1)
    local page, base = writable_page(mem, start // PAGE_SIZE)
    buffer.writeu8(page, base + start % PAGE_SIZE, value)
end

local function load_i8(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_1 then
                return buffer.readi8(low1, off1)
            end
        elseif start < end0 then
            return buffer.readi8(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 1)
    local page, base = find_page(mem, start // PAGE_SIZE)
    return if page then buffer.readi8(page, base + start % PAGE_SIZE) else 0
end

local function load_u16(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_2 then
                return buffer.readu16(low1, off1)
            end
        elseif start + 2 <= end0 then
            return buffer.readu16(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 2)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 2 then
        local page = mem.pages[start // PAGE_SIZE]
        return if page then buffer.readu16(page, within) else 0
    end
    return memory_read_bytes(mem, start, 2)
end

local function load_i16(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_2 then
                return buffer.readi16(low1, off1)
            end
        elseif start + 2 <= end0 then
            return buffer.readi16(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 2)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 2 then
        local page = mem.pages[start // PAGE_SIZE]
        return if page then buffer.readi16(page, within) else 0
    end
    local bits = memory_read_bytes(mem, start, 2)
    return if bits >= 32768 then bits - 65536 else bits
end

local function store_u16(address, offset, value)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_2 then
                buffer.writeu16(low1, off1, value)
                return
            end
        elseif start + 2 <= end0 then
            buffer.writeu16(low0, start, value)
            return
        end
    end
    start = memory_address(mem, address, offset, 2)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 2 then
        buffer.writeu16(writable_page(mem, start // PAGE_SIZE), within, value)
    else
        memory_write_bytes(mem, start, 2, value)
    end
end

local function load_i32(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_4 then
                return buffer.readi32(low1, off1)
            end
        elseif start + 4 <= end0 then
            return buffer.readi32(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 4)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 4 then
        local page = mem.pages[start // PAGE_SIZE]
        return if page then buffer.readi32(page, within) else 0
    end
    local bits = memory_read_bytes(mem, start, 4)
    return if bits >= 2147483648 then bits - ADDRESS_SPACE else bits
end

local function store_i32(address, offset, value)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_4 then
                buffer.writei32(low1, off1, value)
                return
            end
        elseif start + 4 <= end0 then
            buffer.writei32(low0, start, value)
            return
        end
    end
    start = memory_address(mem, address, offset, 4)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 4 then
        buffer.writei32(writable_page(mem, start // PAGE_SIZE), within, value)
    else
        memory_write_bytes(mem, start, 4, value)
    end
end

local function load_u32(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_4 then
                return buffer.readu32(low1, off1)
            end
        elseif start + 4 <= end0 then
            return buffer.readu32(low0, start)
        end
    end
    start = memory_address(mem, address, offset, 4)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 4 then
        local page = mem.pages[start // PAGE_SIZE]
        return if page then buffer.readu32(page, within) else 0
    end
    return memory_read_bytes(mem, start, 4)
end

local function store_u32(address, offset, value)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_4 then
                buffer.writeu32(low1, off1, value)
                return
            end
        elseif start + 4 <= end0 then
            buffer.writeu32(low0, start, value)
            return
        end
    end
    start = memory_address(mem, address, offset, 4)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 4 then
        buffer.writeu32(writable_page(mem, start // PAGE_SIZE), within, value)
    else
        memory_write_bytes(mem, start, 4, value)
    end
end

local function load_wide8_words(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_8 then
                return buffer.readu32(low1, off1), buffer.readu32(low1, off1 + 4)
            end
        elseif start + 8 <= end0 then
            return buffer.readu32(low0, start), buffer.readu32(low0, start + 4)
        end
    end
    start = memory_address(mem, address, offset, 8)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 8 then
        local page = mem.pages[start // PAGE_SIZE]
        if page then
            return buffer.readu32(page, within), buffer.readu32(page, within + 4)
        end
        return 0, 0
    end
    return memory_read_bytes(mem, start, 4), memory_read_bytes(mem, start + 4, 4)
end

local function store_wide8_words(address, offset, lo, hi)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_8 then
                buffer.writeu32(low1, off1, lo)
                buffer.writeu32(low1, off1 + 4, hi)
                return
            end
        elseif start + 8 <= end0 then
            buffer.writeu32(low0, start, lo)
            buffer.writeu32(low0, start + 4, hi)
            return
        end
    end
    start = memory_address(mem, address, offset, 8)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 8 then
        local page = writable_page(mem, start // PAGE_SIZE)
        buffer.writeu32(page, within, lo)
        buffer.writeu32(page, within + 4, hi)
        return
    end
    memory_write_bytes(mem, start, 4, lo)
    memory_write_bytes(mem, start + 4, 4, hi)
end

local function load_wide8(address, offset)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_8 then
                return {lo = buffer.readu32(low1, off1), hi = buffer.readu32(low1, off1 + 4)}
            end
        elseif start + 8 <= end0 then
            return {lo = buffer.readu32(low0, start), hi = buffer.readu32(low0, start + 4)}
        end
    end
    start = memory_address(mem, address, offset, 8)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 8 then
        local page = mem.pages[start // PAGE_SIZE]
        return if page then {lo = buffer.readu32(page, within), hi = buffer.readu32(page, within + 4)} else wide_zero
    end
    return {lo = memory_read_bytes(mem, start, 4), hi = memory_read_bytes(mem, start + 4, 4)}
end

local function store_wide8(address, offset, value)
    local start = address + offset
    if address >= 0 then
        local off1 = start - SEGMENT
        if off1 >= 0 then
            if off1 <= len1_8 then
                buffer.writeu32(low1, off1, value.lo)
                buffer.writeu32(low1, off1 + 4, value.hi)
                return
            end
        elseif start + 8 <= end0 then
            buffer.writeu32(low0, start, value.lo)
            buffer.writeu32(low0, start + 4, value.hi)
            return
        end
    end
    start = memory_address(mem, address, offset, 8)
    local within = start % PAGE_SIZE
    if start >= LOW_LIMIT and within <= PAGE_SIZE - 8 then
        local page = writable_page(mem, start // PAGE_SIZE)
        buffer.writeu32(page, within, value.lo)
        buffer.writeu32(page, within + 4, value.hi)
        return
    end
    memory_write_bytes(mem, start, 4, value.lo)
    memory_write_bytes(mem, start + 4, 4, value.hi)
end

local function memory_load_wide(address, offset, width, signed)
    if width == 8 then return load_wide8(address, offset) end
    local value = if width == 4 then load_u32(address, offset)
        elseif width == 1 then load_u8(address, offset)
        else load_u16(address, offset)
    if signed then
        local limit = if width == 4 then I32_MODULUS elseif width == 2 then 65536 else 256
        if value >= limit / 2 then
            return {lo = value - limit + I32_MODULUS, hi = I32_MODULUS - 1}
        end
    end
    return {lo = value, hi = 0}
end

local function memory_store_wide(address, offset, width, value)
    if width == 8 then store_wide8(address, offset, value)
    elseif width == 4 then store_u32(address, offset, value.lo)
    elseif width == 1 then store_u8(address, offset, value.lo)
    else store_u16(address, offset, value.lo) end
end

local function memory_init_segment(memory, bytes, dest, source, count)
    count %= ADDRESS_SPACE
    source %= ADDRESS_SPACE
    local start = memory_address(memory, dest, 0, count)
    bytes = bytes or ""
    if source + count > #bytes then
        trap("data segment out of bounds")
    end
    if count > 0 then
        memory_init(memory, start, string.sub(bytes, source + 1, source + count))
    end
end

local function memory_fill(memory, dest, value, count)
    count %= ADDRESS_SPACE
    dest = memory_address(memory, dest, 0, count)
    value %= 256
    while count > 0 do
        local index, offset = dest // PAGE_SIZE, dest % PAGE_SIZE
        local chunk = math.min(count, PAGE_SIZE - offset)
        if value ~= 0 or find_page(memory, index) then
            local page, base = writable_page(memory, index)
            buffer.fill(page, base + offset, value, chunk)
        end
        dest += chunk
        count -= chunk
    end
end

local function memory_copy(memory, dest, source, count)
    count %= ADDRESS_SPACE
    dest = memory_address(memory, dest, 0, count)
    source = memory_address(memory, source, 0, count)
    if dest == source then
        return
    end
    local reverse = dest > source and dest < source + count
    if reverse then
        dest += count
        source += count
    end
    while count > 0 do
        local chunk
        if reverse then
            chunk = math.min(count, (dest - 1) % PAGE_SIZE + 1, (source - 1) % PAGE_SIZE + 1)
            dest -= chunk
            source -= chunk
        else
            chunk = math.min(count, PAGE_SIZE - dest % PAGE_SIZE, PAGE_SIZE - source % PAGE_SIZE)
        end
        local destIndex, destOffset = dest // PAGE_SIZE, dest % PAGE_SIZE
        local from, fromBase = find_page(memory, source // PAGE_SIZE)
        if from then
            local to, toBase = writable_page(memory, destIndex)
            buffer.copy(to, toBase + destOffset, from, fromBase + source % PAGE_SIZE, chunk)
        else
            local to, toBase = find_page(memory, destIndex)
            if to then
                buffer.fill(to, toBase + destOffset, 0, chunk)
            end
        end
        if not reverse then
            dest += chunk
            source += chunk
        end
        count -= chunk
    end
end

local abi_types = table.freeze({i32 = "i", i64 = "j", f32 = "f", f64 = "d"})

local function abi_in(kind, value, context)
    if kind == "i" then
        if type(value) == "number" and value >= -I32_SIGN_BIT and value < I32_MODULUS and value % 1 == 0 then
            return if value >= I32_SIGN_BIT then value - I32_MODULUS else value + 0
        end
        error(context .. ": expected an i32 integer", 0)
    elseif kind == "j" then
        local lo = if type(value) == "table" then rawget(value, "lo") else nil
        local hi = if type(value) == "table" then rawget(value, "hi") else nil
        if type(lo) == "number" and lo >= 0 and lo < I32_MODULUS and lo % 1 == 0
            and type(hi) == "number" and hi >= 0 and hi < I32_MODULUS and hi % 1 == 0 then
            return wide(lo, hi)
        end
        error(context .. ": expected i64 words", 0)
    end
    if type(value) ~= "number" then
        error(context .. ": expected a floating-point number", 0)
    end
    return if kind == "f" then f32_bits(value) else f64_bits(value)
end

local function abi_out(kind, value)
    if kind == "j" then
        return wide(value.lo, value.hi)
    elseif kind == "f" then
        return f32_number(value)
    elseif kind == "d" then
        return f64_number(value)
    end
    return value
end

local function export_typed(target, params, results)
    if #results <= 1 and not string.find(params, "[jfd]") and not string.find(results, "[jfd]") then
        return export_function(target, #params)
    end
    return function(...)
        local args = {}
        for index = 1, #params do
            args[index] = abi_in(string.sub(params, index, index), select(index, ...), "argument " .. index)
        end
        local values = target(table.unpack(args, 1, #params))
        if #results == 1 then
            return abi_out(results, values)
        elseif #results > 1 then
            for index = 1, #results do
                values[index] = abi_out(string.sub(results, index, index), values[index])
            end
            return table.unpack(values, 1, #results)
        end
    end
end

local function resolve_import(imports, namespace, name)
    local fields = rawget(imports, namespace)
    local value = if type(fields) == "table" then rawget(fields, name) else nil
    local context = "import " .. string.format("%q.%q", namespace, name)
    if value == nil then
        error(context .. ": missing", 0)
    end
    return value, context
end

local function ret0(ctx, _, _, ...)
    local count = select("#", ...)
    if count ~= 0 then error(ctx .. ": expected 0 results, got " .. count, 0) end
end

local function ret1_i(ctx, _, rctx, ...)
    local count = select("#", ...)
    if count ~= 1 then error(ctx .. ": expected 1 results, got " .. count, 0) end
    local v = ...
    if type(v) == "number" and v % 1 == 0 then
        if v >= -I32_SIGN_BIT and v < I32_SIGN_BIT then
            return v + 0
        elseif v >= I32_SIGN_BIT and v < I32_MODULUS then
            return v - I32_MODULUS
        end
    end
    error(rctx .. ": expected an i32 integer", 0)
end

local function ret1(ctx, kind, rctx, ...)
    local count = select("#", ...)
    if count ~= 1 then error(ctx .. ": expected 1 results, got " .. count, 0) end
    return abi_in(kind, (...), rctx)
end

local function import_function(imports, namespace, name, params, results)
    local cb, ctx = resolve_import(imports, namespace, name)
    if type(cb) ~= "function" then error(ctx .. ": expected a function (" .. params .. " -> " .. results .. ")", 0) end
    local hasNumericParams = string.find(params, "[jfd]") ~= nil
    local rctx = ctx .. " result 1"
    local arity = #params
    if not hasNumericParams and arity <= 10 and #results <= 1 then
        local chk = if #results == 0 then ret0 elseif results == "i" then ret1_i else ret1
        if arity == 0 then return function() return chk(ctx, results, rctx, cb()) end
        elseif arity == 1 then return function(a) return chk(ctx, results, rctx, cb(a)) end
        elseif arity == 2 then return function(a, b) return chk(ctx, results, rctx, cb(a, b)) end
        elseif arity == 3 then return function(a, b, c) return chk(ctx, results, rctx, cb(a, b, c)) end
        elseif arity == 4 then return function(a, b, c, d) return chk(ctx, results, rctx, cb(a, b, c, d)) end
        elseif arity == 5 then return function(a, b, c, d, e) return chk(ctx, results, rctx, cb(a, b, c, d, e)) end
        elseif arity == 6 then return function(a, b, c, d, e, f) return chk(ctx, results, rctx, cb(a, b, c, d, e, f)) end
        elseif arity == 7 then return function(a, b, c, d, e, f, g) return chk(ctx, results, rctx, cb(a, b, c, d, e, f, g)) end
        elseif arity == 8 then return function(a, b, c, d, e, f, g, h) return chk(ctx, results, rctx, cb(a, b, c, d, e, f, g, h)) end
        elseif arity == 9 then return function(a, b, c, d, e, f, g, h, i) return chk(ctx, results, rctx, cb(a, b, c, d, e, f, g, h, i)) end
        end
        return function(a, b, c, d, e, f, g, h, i, j) return chk(ctx, results, rctx, cb(a, b, c, d, e, f, g, h, i, j)) end
    end
    return function(...)
        local args = table.pack(...)
        if hasNumericParams then
            for index = 1, arity do
                args[index] = abi_out(string.sub(params, index, index), args[index])
            end
        end
        local values = table.pack(cb(table.unpack(args, 1, arity)))
        if values.n ~= #results then
            error(ctx .. ": expected " .. #results .. " results, got " .. values.n, 0)
        end
        if #results == 1 then
            return abi_in(results, values[1], rctx)
        elseif #results > 1 then
            for index = 1, #results do
                values[index] = abi_in(string.sub(results, index, index), values[index], ctx .. " result " .. index)
            end
            return values
        end
    end
end

-- Standalone generated modules interoperate through this versioned host protocol.
local function host_handle(kind, backing, methods)
    methods.__texere_v1 = table.freeze({kind = kind, backing = backing})
    return table.freeze(methods)
end

local function backing_of(handle, kind)
    local state = if type(handle) == "table" and table.isfrozen(handle) then rawget(handle, "__texere_v1") else nil
    if type(state) == "table" and table.isfrozen(state) and rawget(state, "kind") == kind then
        return rawget(state, "backing")
    end
    return nil
end

local function global_handle(kind, mutable, initial)
    local state = {kind = kind, mutable = mutable, value = initial}
    local handle = host_handle("global", state, {
        get = function() return abi_out(kind, state.value) end,
        set = function(value)
            if not mutable then
                error("global is immutable", 2)
            end
            state.value = abi_in(kind, value, "global value")
        end,
    })
    return handle, state
end

local function new_global(kind, mutable, value)
    local code = abi_types[kind]
    if not code or type(mutable) ~= "boolean" then
        error("expected a scalar global type and a boolean mutability flag", 2)
    end
    local handle = global_handle(code, mutable, abi_in(code, value, "global value"))
    return handle
end

local function import_global(imports, namespace, name, kind, mutable)
    local handle, context = resolve_import(imports, namespace, name)
    local state = backing_of(handle, "global")
    if type(state) ~= "table" or state.kind ~= kind or state.mutable ~= mutable then
        error(context .. ": incompatible global type or mutability", 0)
    end
    return handle, state
end

local function check_limits(minimum, maximum, cap)
    if type(minimum) ~= "number" or not (minimum >= 0 and minimum <= cap and minimum % 1 == 0)
        or (maximum ~= nil and (type(maximum) ~= "number" or not (maximum >= minimum and maximum <= cap and maximum % 1 == 0))) then
        error("invalid limits", 2)
    end
end

local function import_state(imports, namespace, name, kind, minimum, maximum)
    local handle, context = resolve_import(imports, namespace, name)
    local state = backing_of(handle, kind)
    if type(state) ~= "table" or type(state.size) ~= "number" or state.size < minimum
        or (maximum ~= nil and (type(state.declaredMax) ~= "number" or state.declaredMax > maximum)) then
        error(context .. ": incompatible " .. kind .. " or limits", 0)
    end
    return handle, state
end

local function memory_handle(minimum, maximum)
    local state = new_memory(minimum, maximum or 65536)
    state.declaredMax = maximum
    local handle = host_handle("memory", state, {
        size = function() return state.size end,
        committed_bytes = function() return memory_committed(state) end,
        grow = export_function(function(a) return memory_grow(state, a) end, 1),
        read_u8 = export_function(function(a) return memory_load(state, a, 0, 1, false) end, 1),
        write_u8 = export_function(function(a, b) memory_store(state, a, 0, 1, b) end, 2),
        read_bytes = function(address, count)
            count = abi_in("i", count, "memory byte count") % ADDRESS_SPACE
            local cursor = memory_address(state, abi_in("i", address, "memory address"), 0, count)
            if count == 0 then return "" end
            local offset = cursor % PAGE_SIZE
            if count <= PAGE_SIZE - offset then
                local page, base = find_page(state, cursor // PAGE_SIZE)
                return if page then buffer.readstring(page, base + offset, count) else string.rep("\0", count)
            end
            local chunks = {}
            while count > 0 do
                local offset = cursor % PAGE_SIZE
                local width = math.min(PAGE_SIZE - offset, count)
                local page, base = find_page(state, cursor // PAGE_SIZE)
                chunks[#chunks + 1] = if page then buffer.readstring(page, base + offset, width) else string.rep("\0", width)
                cursor += width
                count -= width
            end
            return table.concat(chunks)
        end,
        write_bytes = function(address, bytes)
            if type(bytes) ~= "string" then
                error("expected a byte string", 2)
            end
            local start = memory_address(state, abi_in("i", address, "memory address"), 0, #bytes)
            memory_init(state, start, bytes)
        end,
        copy = export_function(function(a, b, c) memory_copy(state, a, b, c) end, 3),
    })
    return handle, state
end

local function host_memory(minimum, maximum)
    check_limits(minimum, maximum, 65536)
    local handle = memory_handle(minimum, maximum)
    return handle
end

local TABLE_CAPACITY = 10000000

local function table_range(state, index, count)
    index %= I32_MODULUS
    count %= I32_MODULUS
    if index + count > state.size then
        trap("table out of bounds")
    end
    return index, count
end

local function table_get(state, index)
    return state.entries[table_range(state, index, 1)] or false
end

local function table_set(state, index, value)
    index = table_range(state, index, 1)
    if value then
        local backing = value.__texere_v1.backing
        state.entries[index] = value
        state.targets[index] = backing.target
        state.signatures[index] = backing.signature
    else
        state.entries[index] = nil
        state.targets[index] = nil
        state.signatures[index] = nil
    end
end

local function table_fill(state, start, value, count)
    start, count = table_range(state, start, count)
    if value then
        local backing = value.__texere_v1.backing
        local target, signature = backing.target, backing.signature
        for index = start, start + count - 1 do
            state.entries[index] = value
            state.targets[index] = target
            state.signatures[index] = signature
        end
    else
        for index = start, start + count - 1 do
            state.entries[index] = nil
            state.targets[index] = nil
            state.signatures[index] = nil
        end
    end
end

local function table_grow(state, value, delta)
    local previous = state.size
    local size = previous + delta % I32_MODULUS
    if size > state.maximum or size > TABLE_CAPACITY then
        return -1
    end
    if value then
        local backing = value.__texere_v1.backing
        local target, signature = backing.target, backing.signature
        for index = previous, size - 1 do
            state.entries[index] = value
            state.targets[index] = target
            state.signatures[index] = signature
        end
    end
    state.size = size
    return previous
end

local function table_copy(dest, src, to, from, count)
    to, count = table_range(dest, to, count)
    from = table_range(src, from, count)
    local dEntries, dTargets, dSigs = dest.entries, dest.targets, dest.signatures
    local sEntries, sTargets, sSigs = src.entries, src.targets, src.signatures
    if dest == src and to > from and to < from + count then
        for offset = count - 1, 0, -1 do
            local ref = sEntries[from + offset]
            dEntries[to + offset] = ref
            if ref then
                dTargets[to + offset] = if sTargets then sTargets[from + offset] else ref.__texere_v1.backing.target
                dSigs[to + offset] = if sSigs then sSigs[from + offset] else ref.__texere_v1.backing.signature
            else
                dTargets[to + offset] = nil
                dSigs[to + offset] = nil
            end
        end
    else
        for offset = 0, count - 1 do
            local ref = sEntries[from + offset]
            dEntries[to + offset] = ref
            if ref then
                dTargets[to + offset] = if sTargets then sTargets[from + offset] else ref.__texere_v1.backing.target
                dSigs[to + offset] = if sSigs then sSigs[from + offset] else ref.__texere_v1.backing.signature
            else
                dTargets[to + offset] = nil
                dSigs[to + offset] = nil
            end
        end
    end
end

local function table_init(state, values, dest, source, count)
    dest, count = table_range(state, dest, count)
    source %= I32_MODULUS
    if source + count > (if values then #values else 0) then
        trap("element segment out of bounds")
    end
    local entries, targets, sigs = state.entries, state.targets, state.signatures
    for offset = 0, count - 1 do
        local ref = values[source + offset + 1]
        if ref then
            local backing = ref.__texere_v1.backing
            entries[dest + offset] = ref
            targets[dest + offset] = backing.target
            sigs[dest + offset] = backing.signature
        else
            entries[dest + offset] = nil
            targets[dest + offset] = nil
            sigs[dest + offset] = nil
        end
    end
end

local function function_ref(target, params, results)
    local signature = params .. ">" .. results
    return host_handle("funcref", table.freeze({signature = signature, target = target}), {
        call = export_typed(target, params, results),
    })
end

local function indirect_target(state, index, signature)
    if state.signatures[index] == signature then
        return state.targets[index]
    end
    if index < 0 or index >= state.size then
        trap("table out of bounds")
    end
    if not state.entries[index] then
        trap("null function reference")
    end
    trap("indirect call signature mismatch")
end

local function host_reference(ref)
    if ref == nil then
        return false
    end
    if not backing_of(ref, "funcref") then
        error("expected a Texere function reference or nil", 2)
    end
    return ref
end

local function table_handle(minimum, maximum, fill)
    if minimum > TABLE_CAPACITY then
        trap("table allocation exceeds host capacity")
    end
    local state = {
        size = 0,
        maximum = maximum or I32_MODULUS - 1,
        declaredMax = maximum,
        entries = {},
        targets = {},
        signatures = {},
    }
    table_grow(state, fill, minimum)
    local handle = host_handle("table", state, {
        size = function() return state.size end,
        get = function(index)
            if type(index) == "number" and index >= 0 and index < state.size and index % 1 == 0 then
                return state.entries[index]
            end
            return table_get(state, abi_in("i", index, "table index")) or nil
        end,
        set = function(index, ref)
            table_set(state, abi_in("i", index, "table index"), host_reference(ref))
        end,
        grow = function(delta, ref)
            return table_grow(state, host_reference(ref), abi_in("i", delta, "table growth"))
        end,
    })
    return handle, state
end

local function host_table(minimum, maximum)
    check_limits(minimum, maximum, I32_MODULUS - 1)
    local handle = table_handle(minimum, maximum, false)
    return handle
end

table.freeze(numeric)
return table.freeze({
    I32_MODULUS = I32_MODULUS,
    bind_memory = bind_memory,
    export_typed = export_typed,
    function_ref = function_ref,
